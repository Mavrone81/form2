# Sensitive: source PM record forms. Never commit these.
# Forms may be Excel or PDF, and the forms folder is configurable at runtime,
# so ignore the formats themselves rather than relying on one folder name.
Sample of Forms/
forms/
*.xlsx
*.xls
*.pdf

# Local database and uploaded signatures
*.sqlite
*.sqlite3
*.db
data/

# Node
node_modules/
npm-debug.log*
.env
.env.*
!.env.example

# macOS
.DS_Store

# Design mockups render real form content (task text, doc numbers) for
# fidelity. That content is sensitive, so mockups stay local.
docs/design/

# Generated from the sensitive forms folder
test/fixtures.local.json

# Completed/signed PM records (the expected output format). Sensitive.
PM Document 2026/

# Host-specific compose override; only the .example is committed
compose.override.yaml

# The Android app's PDF engine is BUILT from server/pdf-record.js and the
# vendored fonts (mobile/pdf-engine/build.mjs). Committing the bundle would
# commit a second, silently forkable copy of the renderer; CI and the app
# build it, and test/pdf-engine-golden.test.js skips when it is absent.
mobile/pdf-engine/dist/
